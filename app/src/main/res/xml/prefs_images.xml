<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="Bilder" app:iconSpaceReserved="false">
        <Preference
            app:key="menu_source"
            app:title="Quelle"
            app:fragment="app.galerie.tv.SettingsActivity$Prefs"
            app:iconSpaceReserved="false">
            <extra android:name="xml" android:value="prefs_source" />
        </Preference>
        <Preference
            app:key="upload"
            app:iconSpaceReserved="false"
            app:title="Hochladen"
            app:summary="Bilder vom Handy oder PC – zeigt Adresse und QR-Code" />
        <ListPreference
            app:key="interval"
            app:defaultValue="600"
            app:entries="@array/interval_labels"
            app:entryValues="@array/interval_values"
            app:iconSpaceReserved="false"
            app:title="Bild wechseln alle"
            app:useSimpleSummaryProvider="true" />
        <Preference
            app:key="menu_format"
            app:title="Format &amp; Cache"
            app:fragment="app.galerie.tv.SettingsActivity$Prefs"
            app:iconSpaceReserved="false">
            <extra android:name="xml" android:value="prefs_format" />
        </Preference>
    </PreferenceCategory>
</PreferenceScreen>
