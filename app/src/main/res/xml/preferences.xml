<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="Modus" app:iconSpaceReserved="false">
        <ListPreference
            app:key="mode"
            app:defaultValue="art"
            app:entries="@array/mode_labels"
            app:entryValues="@array/mode_values"
            app:iconSpaceReserved="false"
            app:title="Anzeigemodus"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

    <PreferenceCategory app:title="Eigene Bilder" app:iconSpaceReserved="false">
        <Preference
            app:key="upload"
            app:iconSpaceReserved="false"
            app:title="Bilder vom Handy oder PC hinzufügen"
            app:summary="Zeigt Adresse und QR-Code – Bilder im Browser hochladen" />
        <SwitchPreferenceCompat
            app:key="source_local"
            app:defaultValue="true"
            app:iconSpaceReserved="false"
            app:title="Eigene Bilder anzeigen" />
        <SwitchPreferenceCompat
            app:key="source_usb"
            app:dependency="source_local"
            app:defaultValue="false"
            app:iconSpaceReserved="false"
            app:title="Auch Ordner vom USB-Stick"
            app:summary="Alle Bilder in einem Ordner mit dem unten eingestellten Namen" />
        <EditTextPreference
            app:key="local_folder"
            app:dependency="source_usb"
            app:defaultValue="Galerie"
            app:iconSpaceReserved="false"
            app:title="Ordnername auf dem USB-Stick"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

    <PreferenceCategory app:title="Museumskunst" app:iconSpaceReserved="false">
        <SwitchPreferenceCompat
            app:key="source_met"
            app:defaultValue="true"
            app:iconSpaceReserved="false"
            app:title="Gemeinfreie Gemälde"
            app:summary="Aus dem Metropolitan Museum of Art, New York" />
        <MultiSelectListPreference
            app:key="collections"
            app:dependency="source_met"
            app:defaultValue="@array/collection_defaults"
            app:entries="@array/collection_labels"
            app:entryValues="@array/collection_values"
            app:iconSpaceReserved="false"
            app:title="Sammlungen" />
    </PreferenceCategory>

    <PreferenceCategory app:title="Bildformat" app:iconSpaceReserved="false">
        <SwitchPreferenceCompat
            app:key="crop169"
            app:defaultValue="true"
            app:iconSpaceReserved="false"
            app:title="Auf 16:9 zuschneiden"
            app:summary="Bilder füllen den Fernseher. Museumsbilder im Hochformat werden übersprungen." />
        <ListPreference
            app:key="min_res"
            app:defaultValue="1080"
            app:entries="@array/minres_labels"
            app:entryValues="@array/minres_values"
            app:iconSpaceReserved="false"
            app:title="Mindestauflösung"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

    <PreferenceCategory app:title="Wetter-Modus: Uhr &amp; Wetter" app:iconSpaceReserved="false">
        <SwitchPreferenceCompat
            app:key="clock"
            app:defaultValue="true"
            app:iconSpaceReserved="false"
            app:title="Uhrzeit und Datum anzeigen" />
        <ListPreference
            app:key="weather"
            app:defaultValue="now"
            app:entries="@array/weather_labels"
            app:entryValues="@array/weather_values"
            app:iconSpaceReserved="false"
            app:title="Wetter"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:key="weather_city"
            app:defaultValue=""
            app:iconSpaceReserved="false"
            app:title="Ort für das Wetter"
            app:dialogMessage="Stadt oder Ort, z. B. Hamburg" />
        <ListPreference
            app:key="overlay_pos"
            app:defaultValue="bottom_right"
            app:entries="@array/pos_labels"
            app:entryValues="@array/pos_values"
            app:iconSpaceReserved="false"
            app:title="Position von Uhr und Wetter"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

    <PreferenceCategory app:title="Art-Modus: Rahmen" app:iconSpaceReserved="false">
        <ListPreference
            app:key="matte"
            app:defaultValue="modern"
            app:entries="@array/matte_labels"
            app:entryValues="@array/matte_values"
            app:iconSpaceReserved="false"
            app:title="Passepartout-Stil"
            app:useSimpleSummaryProvider="true" />
        <ListPreference
            app:key="matte_color"
            app:defaultValue="#F4F2EE"
            app:entries="@array/matte_color_labels"
            app:entryValues="@array/matte_color_values"
            app:iconSpaceReserved="false"
            app:title="Farbe des Passepartouts"
            app:useSimpleSummaryProvider="true" />
        <ListPreference
            app:key="art_size"
            app:defaultValue="68"
            app:entries="@array/size_labels"
            app:entryValues="@array/size_values"
            app:iconSpaceReserved="false"
            app:title="Bildgröße im Passepartout"
            app:useSimpleSummaryProvider="true" />
        <SwitchPreferenceCompat
            app:key="canvas"
            app:defaultValue="true"
            app:iconSpaceReserved="false"
            app:title="Leinwand-Effekt"
            app:summary="Feine Struktur und gedämpfte Farben – wirkt wie ein echtes Bild statt eines leuchtenden Bildschirms" />
    </PreferenceCategory>

    <PreferenceCategory app:title="Alle Modi" app:iconSpaceReserved="false">
        <ListPreference
            app:key="brightness"
            app:defaultValue="85"
            app:entries="@array/brightness_labels"
            app:entryValues="@array/brightness_values"
            app:iconSpaceReserved="false"
            app:title="Helligkeit"
            app:useSimpleSummaryProvider="true" />
        <SwitchPreferenceCompat
            app:key="caption"
            app:defaultValue="true"
            app:iconSpaceReserved="false"
            app:title="Bildinfo einblenden"
            app:summary="Titel und Künstler nach jedem Wechsel kurz anzeigen" />
        <ListPreference
            app:key="interval"
            app:defaultValue="600"
            app:entries="@array/interval_labels"
            app:entryValues="@array/interval_values"
            app:iconSpaceReserved="false"
            app:title="Bild wechseln alle"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

    <PreferenceCategory app:title="Bildschirmschoner" app:iconSpaceReserved="false">
        <Preference
            app:key="preview"
            app:iconSpaceReserved="false"
            app:title="Vorschau starten"
            app:summary="Jetzt anzeigen · ◀ ▶ Bild wechseln · ▼ Modus wechseln" />
        <Preference
            app:key="set_screensaver"
            app:iconSpaceReserved="false"
            app:title="Als Bildschirmschoner festlegen"
            app:summary="Öffnet die Android-TV-Einstellungen für den Bildschirmschoner" />
        <Preference
            app:key="clear_cache"
            app:iconSpaceReserved="false"
            app:title="Bild-Cache leeren" />
    </PreferenceCategory>
</PreferenceScreen>
