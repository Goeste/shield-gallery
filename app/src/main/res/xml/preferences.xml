<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="Einstellungen" app:iconSpaceReserved="false">
        <Preference
            app:key="menu_style"
            app:title="Stil"
            app:fragment="app.galerie.tv.SettingsActivity$Prefs"
            app:iconSpaceReserved="false">
            <extra android:name="xml" android:value="prefs_style" />
        </Preference>
        <Preference
            app:key="menu_weather"
            app:title="Wetter"
            app:fragment="app.galerie.tv.SettingsActivity$Prefs"
            app:iconSpaceReserved="false">
            <extra android:name="xml" android:value="prefs_weather" />
        </Preference>
        <Preference
            app:key="menu_clock"
            app:title="Uhr"
            app:fragment="app.galerie.tv.SettingsActivity$Prefs"
            app:iconSpaceReserved="false">
            <extra android:name="xml" android:value="prefs_clock" />
        </Preference>
        <Preference
            app:key="menu_images"
            app:title="Bilder"
            app:fragment="app.galerie.tv.SettingsActivity$Prefs"
            app:iconSpaceReserved="false">
            <extra android:name="xml" android:value="prefs_images" />
        </Preference>
    </PreferenceCategory>

    <PreferenceCategory app:title="Schnellzugriff" app:iconSpaceReserved="false">
        <Preference
            app:key="preview"
            app:iconSpaceReserved="false"
            app:title="Vorschau starten"
            app:summary="Jetzt anzeigen · ◀ ▶ Bild wechseln · ▼ Stil wechseln" />
        <Preference
            app:key="set_screensaver"
            app:iconSpaceReserved="false"
            app:title="Als Bildschirmschoner festlegen"
            app:summary="Öffnet die Android-TV-Einstellungen für den Bildschirmschoner" />
    </PreferenceCategory>
</PreferenceScreen>
