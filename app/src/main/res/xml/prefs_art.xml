<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="Art – Bild im Rahmen-Stil mit Passepartout" app:iconSpaceReserved="false">
        <Preference
            app:key="use_art"
            app:iconSpaceReserved="false"
            app:title="Diesen Stil verwenden" />
        <SwitchPreferenceCompat
            app:key="art_caption"
            app:defaultValue="true"
            app:iconSpaceReserved="false"
            app:title="Titel"
            app:summary="Titel und Künstler nach jedem Bildwechsel kurz einblenden (OK-Taste zeigt ihn jederzeit)" />
        <SwitchPreferenceCompat
            app:key="art_clock"
            app:defaultValue="false"
            app:iconSpaceReserved="false"
            app:title="Uhr"
            app:summary="Uhrzeit und Datum – Format und Position im Menü „Uhr“" />
        <SwitchPreferenceCompat
            app:key="art_weather"
            app:defaultValue="false"
            app:iconSpaceReserved="false"
            app:title="Wetter"
            app:summary="Ort, Einheit und Position im Menü „Wetter“" />
    </PreferenceCategory>

    <PreferenceCategory app:title="Rahmen &amp; Größe" app:iconSpaceReserved="false">
        <ListPreference
            app:key="matte"
            app:defaultValue="modern"
            app:entries="@array/matte_labels"
            app:entryValues="@array/matte_values"
            app:iconSpaceReserved="false"
            app:title="Passepartout-Stil"
            app:useSimpleSummaryProvider="true" />
        <ListPreference
            app:key="matte_color"
            app:defaultValue="#F4F2EE"
            app:entries="@array/matte_color_labels"
            app:entryValues="@array/matte_color_values"
            app:iconSpaceReserved="false"
            app:title="Farbe des Passepartouts"
            app:useSimpleSummaryProvider="true" />
        <ListPreference
            app:key="art_size"
            app:defaultValue="76"
            app:entries="@array/size_labels"
            app:entryValues="@array/size_values"
            app:iconSpaceReserved="false"
            app:title="Bildgröße"
            app:useSimpleSummaryProvider="true" />
        <SwitchPreferenceCompat
            app:key="canvas"
            app:defaultValue="true"
            app:iconSpaceReserved="false"
            app:title="Leinwand-Effekt"
            app:summary="Feine Struktur und gedämpfte Farben – wirkt wie ein echtes Bild statt eines leuchtenden Bildschirms" />
    </PreferenceCategory>
</PreferenceScreen>
