<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="Art-Modus" app:iconSpaceReserved="false">
        <ListPreference
            app:key="matte"
            app:defaultValue="modern"
            app:entries="@array/matte_labels"
            app:entryValues="@array/matte_values"
            app:iconSpaceReserved="false"
            app:title="Passepartout-Stil"
            app:useSimpleSummaryProvider="true" />
        <ListPreference
            app:key="matte_color"
            app:defaultValue="#F4F2EE"
            app:entries="@array/matte_color_labels"
            app:entryValues="@array/matte_color_values"
            app:iconSpaceReserved="false"
            app:title="Farbe des Passepartouts"
            app:useSimpleSummaryProvider="true" />
        <ListPreference
            app:key="art_size"
            app:defaultValue="76"
            app:entries="@array/size_labels"
            app:entryValues="@array/size_values"
            app:iconSpaceReserved="false"
            app:title="Bildgröße im Passepartout"
            app:useSimpleSummaryProvider="true" />
        <SwitchPreferenceCompat
            app:key="canvas"
            app:defaultValue="true"
            app:iconSpaceReserved="false"
            app:title="Leinwand-Effekt"
            app:summary="Feine Struktur und gedämpfte Farben – wirkt wie ein echtes Bild statt eines leuchtenden Bildschirms" />
    </PreferenceCategory>

    <PreferenceCategory app:title="Auf dem Passepartout" app:iconSpaceReserved="false">
        <SwitchPreferenceCompat
            app:key="art_clock"
            app:defaultValue="false"
            app:iconSpaceReserved="false"
            app:title="Uhrzeit und Datum"
            app:summary="Dezent unter oder über dem Bild" />
        <SwitchPreferenceCompat
            app:key="art_weather"
            app:defaultValue="false"
            app:iconSpaceReserved="false"
            app:title="Wetter"
            app:summary="Ort und Vorschau unter „Uhr &amp; Wetter“" />
    </PreferenceCategory>
</PreferenceScreen>
