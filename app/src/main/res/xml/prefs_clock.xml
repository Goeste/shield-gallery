<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="Uhr" app:iconSpaceReserved="false">
        <ListPreference
            app:key="clock_format"
            app:defaultValue="24"
            app:entries="@array/clock_format_labels"
            app:entryValues="@array/clock_format_values"
            app:iconSpaceReserved="false"
            app:title="Format"
            app:useSimpleSummaryProvider="true" />
        <ListPreference
            app:key="clock_pos"
            app:defaultValue="bottom_right"
            app:entries="@array/pos_labels"
            app:entryValues="@array/pos_values"
            app:iconSpaceReserved="false"
            app:title="Position"
            app:useSimpleSummaryProvider="true" />
        <Preference
            app:key="clock_note"
            app:selectable="false"
            app:iconSpaceReserved="false"
            app:summary="Ob die Uhr angezeigt wird, stellst du je Stil unter „Stil“ ein. Stehen Uhr und Wetter an derselben Position, erscheinen sie untereinander." />
    </PreferenceCategory>
</PreferenceScreen>
