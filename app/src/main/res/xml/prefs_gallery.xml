<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="Galerie-Modus" app:iconSpaceReserved="false">
        <SwitchPreferenceCompat
            app:key="gallery_matte"
            app:defaultValue="true"
            app:iconSpaceReserved="false"
            app:title="Schmales Passepartout am Rand"
            app:summary="Ein sehr schmaler Rand rundum – der Fernseher wirkt wie der Bilderrahmen. Farbe wie im Art-Modus." />
    </PreferenceCategory>

    <PreferenceCategory app:title="Über dem Bild" app:iconSpaceReserved="false">
        <SwitchPreferenceCompat
            app:key="gallery_clock"
            app:defaultValue="false"
            app:iconSpaceReserved="false"
            app:title="Uhrzeit und Datum"
            app:summary="Wie im Wetter-Modus" />
        <SwitchPreferenceCompat
            app:key="gallery_weather"
            app:defaultValue="false"
            app:iconSpaceReserved="false"
            app:title="Wetter"
            app:summary="Ort und Vorschau unter „Uhr &amp; Wetter“" />
    </PreferenceCategory>
</PreferenceScreen>
